# Copy to .env (git-ignored) only if you rebuild the data snapshot from the original sources.
# Nothing in this file is needed to grade answers or to reproduce the paper tables.

# SEC EDGAR needs no key, but every request must carry a name and a contact email.
# Format: "Name or organisation email@example.com". Limit 10 requests per second.
SEC_USER_AGENT=

# FRED (Treasury rates and credit spreads). Optional: without a key the fetcher uses the keyless CSV download.
# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
